# Next.js 16 com rotas server-side e BFF — não usar static export.
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json ./
RUN npm install --no-audit --no-fund

FROM node:22-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ARG NEXT_PUBLIC_BIOMETRIC_ENABLED=false
ARG NEXT_PUBLIC_DEPLOY_CHANNEL=staging
ENV NEXT_PUBLIC_BIOMETRIC_ENABLED=${NEXT_PUBLIC_BIOMETRIC_ENABLED}
ENV NEXT_PUBLIC_DEPLOY_CHANNEL=${NEXT_PUBLIC_DEPLOY_CHANNEL}
RUN mkdir -p public && npm run build

FROM node:22-alpine AS runtime
WORKDIR /app
RUN addgroup --system --gid 10001 autominas && \
    adduser --system --uid 10001 --ingroup autominas nextjs
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000
COPY --from=build --chown=nextjs:autominas /app/.next/standalone ./
COPY --from=build --chown=nextjs:autominas /app/.next/static ./.next/static
COPY --from=build --chown=nextjs:autominas /app/public ./public
USER nextjs
EXPOSE 3000
CMD ["node","server.js"]
